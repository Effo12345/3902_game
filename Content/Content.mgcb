
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Config/attacks.json
/copy:Config/attacks.json

#begin Config/backgrounds.json
/copy:Config/backgrounds.json

#begin Config/blueshell.json
