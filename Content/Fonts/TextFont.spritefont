<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:ns="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="ns:FontDescription">
    <!-- Try Arial Black first; if your OS doesn't have it, change to Arial -->
    <FontName>Arial Black</FontName>
    <Size>26</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start> </Start>
        <End>~</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
